{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cu-03-extraccion-clinica/schema/1.0/document.json",
  "title": "Documento clínico estructurado CU-03",
  "type": "object",
  "required": [
    "schema_version",
    "language",
    "source_text",
    "entities"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "document_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "const": "es"
    },
    "source_text": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "type",
          "start",
          "end",
          "coding",
          "normalization_status"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "disease",
              "symptom",
              "drug",
              "procedure"
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "coding": {
            "type": "object",
            "required": [
              "system",
              "code",
              "display"
            ],
            "properties": {
              "system": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "display": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "normalization_status": {
            "enum": [
              "matched",
              "not_found",
              "ambiguous"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
